# Security headers for Cloudflare Pages (also applied by scripts/serve.mjs in local and end-to-end runs).
# CSP notes:
#  - 'wasm-unsafe-eval' lets the PDF library compile its WebAssembly layout engine. It does not allow JavaScript eval.
#  - connect-src data: lets that engine read its WebAssembly module, which ships inline as a data: URL.
#  - No third-party origins anywhere: fonts, scripts, styles, and data are all served from this site.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable
